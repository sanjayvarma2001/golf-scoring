# Copy this file to .env and fill in real values: `cp .env.example .env`.
# .env is gitignored and must never be committed. JWT_SECRET_KEY and
# ADMIN_PASSWORD below have no default in code on purpose - the app will
# refuse to start until you set them here, in your own .env.

ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:3000

# --- Database ---
# Local dev default (no setup required):
DATABASE_URL=sqlite+aiosqlite:///./golf_scoring.db
# Production (Supabase, use the POOLED connection string - port 6543 - on serverless hosts):
# DATABASE_URL=postgresql+asyncpg://postgres:<password>@<project-ref>.pooler.supabase.com:6543/postgres

# --- Auth (required - the app won't start without this) ---
# Generate a real one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Bootstrap admin account (used only by seed.py; required to run it) ---
ADMIN_EMAIL=admin@digitalheroes.local
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Stripe (optional locally; required for real payments) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_YEARLY=
